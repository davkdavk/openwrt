--- a/mt7615/eeprom.c
+++ b/mt7615/eeprom.c
@@ -5,9 +5,12 @@
  *         Felix Fietkau <nbd@nbd.name>
  */
 
+#include <linux/mtd/mtd.h>
 #include <linux/of.h>
 #include "mt7615.h"
 #include "eeprom.h"
+
+static int mt7615_check_eeprom(struct mt76_dev *dev);
 
 static int mt7615_efuse_read(struct mt7615_dev *dev, u32 base,
 			     u16 addr, u8 *data)
@@ -80,6 +83,41 @@
 	ret = mt76_eeprom_init(&dev->mt76, MT7615_EEPROM_FULL_SIZE);
 	if (ret < 0)
 		return ret;
+
+	if (is_mt7663(&dev->mt76)) {
+		struct mtd_info *mtd;
+		u8 *fbuf;
+		size_t retlen;
+		int err;
+
+		mtd = get_mtd_device_nm("factory");
+		if (IS_ERR(mtd))
+			mtd = get_mtd_device(NULL, 2);
+
+		if (!IS_ERR(mtd)) {
+			if (mtd->size >= 0x8000 + MT7663_EEPROM_SIZE) {
+				fbuf = kmalloc(MT7663_EEPROM_SIZE, GFP_KERNEL);
+				if (fbuf) {
+					err = mtd_read(mtd, 0x8000,
+						       MT7663_EEPROM_SIZE,
+						       &retlen, fbuf);
+					if ((err == 0 || mtd_is_bitflip(err)) &&
+					    retlen == MT7663_EEPROM_SIZE &&
+					    get_unaligned_le16(fbuf) == 0x7663) {
+						memset(dev->mt76.eeprom.data, 0,
+						       dev->mt76.eeprom.size);
+						memcpy(dev->mt76.eeprom.data,
+						       fbuf, MT7663_EEPROM_SIZE);
+						dev_info(dev->mt76.dev,
+							 "found embedded MT7663 EEPROM at offset 0x%x\n",
+							 0x8000);
+					}
+					kfree(fbuf);
+				}
+			}
+			put_mtd_device(mtd);
+		}
+	}
 
 	return mt7615_efuse_init(dev, addr);
 }
