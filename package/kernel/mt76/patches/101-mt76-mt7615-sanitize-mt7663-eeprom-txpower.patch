+static inline bool
+mt7615_eeprom_valid(struct mt7615_dev *dev, u32 offset, u32 len)
+{
+	return dev->mt76.eeprom.data &&
+	       offset < dev->mt76.eeprom.size &&
+	       len <= dev->mt76.eeprom.size - offset;
+}
+
+static inline bool
+mt7615_eeprom_read_byte(struct mt7615_dev *dev, u32 offset, u8 *val)
+{
+	if (!val || !mt7615_eeprom_valid(dev, offset, sizeof(*val)))
+		return false;
+
+	*val = ((u8 *)dev->mt76.eeprom.data)[offset];
+	return true;
+}
