+static bool mt7615_eeprom_read_smg(struct mt7615_dev *dev, u32 offset, s8 *delta)
+{
+	u8 val;
+	s8 magnitude;
+
+	if (!delta || !mt7615_eeprom_read_byte(dev, offset, &val) ||
+	    !(val & MT_EE_RATE_POWER_EN))
+		return false;
+
+	magnitude = FIELD_GET(MT_EE_RATE_POWER_MASK, val);
+	*delta = magnitude;
+	if (val & MT_EE_RATE_POWER_SIGN)
+		*delta = -*delta;
+
+	return true;
+}
+
+s8 mt7615_mt7663_dpd_backoff(struct mt7615_dev *dev)
+{
+	s8 dpd0 = 0, dpd1 = 0;
+	bool have0 = mt7615_eeprom_read_smg(dev, MT7615_EEPROM_MT7663_DPD0, &dpd0);
+	bool have1 = mt7615_eeprom_read_smg(dev, MT7615_EEPROM_MT7663_DPD1, &dpd1);
+
+	if (have0 && have1)
+		return min(dpd0, dpd1);
+	if (have0)
+		return dpd0;
+	if (have1)
+		return dpd1;
+
+	return 0;
+}
+
+int mt7615_mt7663_rate_delta(struct mt7615_dev *dev,
+				     struct ieee80211_channel *chan,
+				     u8 chain_idx)
+{
+	u32 base = chain_idx ? MT7615_EEPROM_MT7663_5G_CHAIN1_DELTA :
+			 MT7615_EEPROM_MT7663_5G_CHAIN0_DELTA;
+	s8 delta;
+	int group;
+
+	if (chan->band != NL80211_BAND_5GHZ)
+		return 0;
+
+	group = mt7615_get_channel_group(chan->hw_value);
+	if (group < 0)
+		return 0;
+
+	if (!mt7615_eeprom_read_smg(dev, base + min(group, 7), &delta))
+		return 0;
+
+	return delta;
+}
+
+s8 mt7615_mt7663_rate_base(struct mt7615_dev *dev,
+				    struct ieee80211_channel *chan)
+{
+	u8 val;
+	int group;
+
+	if (chan->band != NL80211_BAND_5GHZ)
+		return 0;
+
+	group = mt7615_get_channel_group(chan->hw_value);
+	group = clamp(group, 0, 7);
+
+	if (!mt7615_eeprom_read_byte(dev, MT7615_EEPROM_MT7663_5G_RATE_TABLE + group,
+				     &val))
+		return 0;
+
+	return val;
 }
 
